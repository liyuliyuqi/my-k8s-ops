apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-config
  namespace: monitoring
type: Opaque
stringData:
  alertmanager.yml: |
    global:
      resolve_timeout: 5m
      smtp_from: '<你的QQ邮箱>'
      smtp_smarthost: 'smtp.qq.com:465'
      smtp_auth_username: '<你的QQ邮箱>'
      smtp_auth_password: '<你的SMTP授权码>'
      smtp_require_tls: false
    route:
      receiver: email
      group_by: ["alertname"]
      group_wait: 10s
      group_interval: 5m
      repeat_interval: 4h
    receivers:
    - name: email
      email_configs:
      - to: '<收件邮箱>'
        send_resolved: true
